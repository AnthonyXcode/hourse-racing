{
  "name": "horse-racing-training",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local HKJC bet-practice trainer. Pick a meeting, build a bet, settle hit/miss against historical results.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "names:backfill": "tsx --env-file-if-exists=.env server/names/backfill.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:import": "tsx server/data/importFiles.ts",
    "data:fetch": "tsx server/data/fetchCli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2",
    "firebase": "^12.19.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "motion": "^13.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
