# Copy to marketing/.env (gitignored, chmod 600). Real environment variables override this file.

# 1 = really publish. Anything else (or unset) = dry run. Leave unset for the first week.
MARKETING_LIVE=1

# Personal accounts via the browser (Playwright + Chrome, no tokens): channels listed here are posted by
# filling the website's composer in marketing/.browser-profile. Log in once: npx tsx marketing/scripts/browser-login.ts
# The FB/IG/Threads API settings below are then unused for those channels.
BROWSER_CHANNELS=facebook,instagram,threads
# 1 = no visible window (Meta challenges headless browsers more often; leave empty)
BROWSER_HEADLESS=
BROWSER_SLOWMO_MS=120

# Facebook Page (Graph API). The Page token also publishes to the linked Instagram account.
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Optional: lets refresh-tokens.ts inspect the Page token (debug_token: expiry + scopes)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Instagram professional account linked to the Page (uses FB_PAGE_TOKEN unless IG_TOKEN is set)
IG_USER_ID=
IG_TOKEN=

# Threads (long-lived token; refresh-tokens.ts rewrites THREADS_TOKEN weekly)
THREADS_USER_ID=
THREADS_TOKEN=
THREADS_API_BASE=https://graph.threads.com/v1.0

# Telegram: bot is an admin of the channel; alerts go to the owner's private chat with the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@posttimehk
TELEGRAM_ALERT_CHAT_ID=

# Public image hosting for Instagram/Threads (nginx serves IMAGE_RSYNC_TARGET at IMAGE_PUBLIC_BASE_URL)
IMAGE_PUBLIC_BASE_URL=https://posttimehk.com/social
IMAGE_RSYNC_TARGET=deploy@posttimehk.com:/var/www/posttime-social/

# Optional
MARKETING_SITE_URL=https://posttimehk.com
FB_LINK_PREVIEW=1
MARKETING_ALERTS=1
