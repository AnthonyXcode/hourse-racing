# Copy to .env and edit. .env is gitignored.
#
#   cp .env.example .env
#
# Real environment variables win over this file, so pm2's env block (or an
# inline `PORT=9000 npm start`) overrides whatever is set here.

# Backend — the Express server: API, and in production the built SPA too.
# This is the port you open in production.
PORT=8787

# Frontend — the Vite dev server (`npm run dev` only).
# Not used in production: `npm run build` emits dist/, which the backend serves.
# Open this port during development.
WEB_PORT=5173

# Timezone. Keep Asia/Hong_Kong: on a UTC host, race dates come out a day early.
TZ=Asia/Hong_Kong

# Market momentum collector (Momentum tab). On race days the server snapshots
# HKJC WIN/PLA odds for every race inside the window before its post time.
MOMENTUM_POLLER=1          # 0 disables the background collector
MOMENTUM_INTERVAL_S=30     # seconds between snapshots
MOMENTUM_WINDOW_MIN=30     # start this many minutes before post time
# MOMENTUM_DB=data/momentum.sqlite   # SQLite file (default shown)
