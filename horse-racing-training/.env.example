# Copy to .env and edit. .env is gitignored.
#
#   cp .env.example .env
#
# Real environment variables win over this file, so pm2's env block (or an
# inline `PORT=9000 npm start`) overrides whatever is set here.

# Backend — the Express server: API, and in production the built SPA too.
# This is the port you open in production.
PORT=8787

# Frontend — the Vite dev server (`npm run dev` only).
# Not used in production: `npm run build` emits dist/, which the backend serves.
# Open this port during development.
WEB_PORT=5173

# Timezone. Keep Asia/Hong_Kong: on a UTC host, race dates come out a day early.
TZ=Asia/Hong_Kong

# Market momentum collector (Momentum tab). On race days the server snapshots
# HKJC WIN/PLA odds for every race inside the window before its post time.
MOMENTUM_POLLER=1          # 0 disables the background collector
MOMENTUM_INTERVAL_S=10     # seconds between snapshots
MOMENTUM_WINDOW_MIN=30     # start this many minutes before post time
# MOMENTUM_DB=data/momentum.sqlite   # SQLite file (default shown)

# Scheduled HKJC fetch of racecards + odds + results into the DB, every 5 min at
# 12:00–00:00 Hong Kong time (Playwright; needs `npx playwright install chromium`
# in the parent repo). Full card scrapes are hourly; see server/data/fetchJobs.ts. Off unless set to 1 — enable it on the machine that
# should keep the data current. Manual run: `npm run data:fetch [-- --dry-run]`.
DATA_FETCH=0

# Background refresh of Chinese horse/jockey/trainer/race names (1 page/s).
# On unless set to 0.
NAMES_REFRESH=1

# Google Analytics for Firebase runs in production builds only. Set to 1 to also send
# events from `npm run dev` (e.g. to check them in Firebase DebugView). Read by Vite at startup.
# VITE_ANALYTICS=1

# ---- Membership (HK mobile + SMS code login; docs/membership/PRD.md) ----
# The server refuses to start with NODE_ENV=production if OTP_PROVIDER=mock, the Turnstile test keys
# are in use, or any Twilio variable is missing.

# SMS codes: "mock" (dev default: the code is printed in the server log as
# "[otp:mock] +852****4567 code=123456") or "twilio" (production default).
OTP_PROVIDER=mock
# Twilio Verify credentials — set them only in the real .env / environment, never in git.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Cloudflare Turnstile (bot check before every SMS). Unset in dev = Cloudflare's always-pass test keys
# below. Production needs real keys from the Cloudflare dashboard.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# MEMBERS_DB=data/members.sqlite   # SQLite file for members, sessions and bet history (gitignored)
# AVATAR_DIR=data/avatars          # processed avatar images (gitignored)
# SESSION_TTL_DAYS=30              # login lasts this long since the last visit (sliding)

# Origin(s) allowed to make state-changing /api/auth, /api/me and /api/history calls (comma-separated).
# Production: the public https origin, e.g. https://posttime.example.
APP_ORIGIN=http://localhost:5173

# Behind nginx / Cloudflare: number of proxy hops to trust for the client IP (per-IP rate limits).
# TRUST_PROXY=1

# OTP send limits (optional overrides): per phone per hour / per day, per IP per hour.
# OTP_RATE_PHONE_HOUR=5
# OTP_RATE_PHONE_DAY=10
# OTP_RATE_IP_HOUR=20

# ---- Credits, LIVE betting and Stripe (docs/credits/PRD.md §9) ----
# LEGAL GATE: keep FUTURE_BETTING=0 and test keys only until HK counsel (Gambling Ordinance Cap. 148 /
# HKJC exclusivity) and Stripe have approved the model in writing.
# 1 = LIVE bets and buying credits are on. 0 = both off (503); pending bets still settle, webhooks still run.
FUTURE_BETTING=0
# LIVE also needs DATA_FETCH=1 above (post times + results come from the fetch job), except in dev with DEV_NOW.

# Stripe (test mode first: sk_test_…). Never commit real values; set them only in .env / the environment.
# Without STRIPE_SECRET_KEY, buying credits answers 503 stripe_unconfigured.
# STRIPE_SECRET_KEY=
# Webhook signing secret: `stripe listen` prints a whsec_… for local testing.
# STRIPE_WEBHOOK_SECRET=
# A sk_live_ key is refused unless this is 1 (set only after legal + Stripe approval).
# STRIPE_LIVE_APPROVED=

# CREDITS_SIGNUP_BONUS=1000        # free credits, once per phone number ever
# CREDITS_PEPPER=                  # HMAC key for the one-bonus-per-phone record; REQUIRED (secret) in production
# PURCHASE_DAILY_CAP_HKD=1000      # per member per Hong Kong calendar day
# LIVE_MAX_STAKE=50000             # credits per LIVE bet item

# Dev only (refused in production): start the server clock at this time, so a stored upcoming meeting can be
# bet on with a dev schedule (npm run credits -- dev-schedule …). See README → Credits.
# DEV_NOW=2026-10-04T11:00:00+08:00

# ---- Admin panel (/admin; docs/admin/PRD.md §9) ----
# The owner is the member whose login number is OWNER_PHONE (any HK format). Never stored in the DB, never set
# from the UI. Required (and validated) in production; in dev, unset = nobody is owner (a startup warning).
# Example placeholder only — put the real number in your own .env:
# OWNER_PHONE=9123 4567
# ADMIN_STEPUP_MINUTES=5      # how long an SMS code counts as step-up for sensitive owner actions
# ADMIN_STEPUP_CREDITS=1000   # |credit adjust| at or above which a step-up code is needed
# ADMIN_EXPORT_MAX_ROWS=50000
# ADMIN_ACCESS_LOG_DAYS=365   # access-log retention (never less than 365; the audit log is kept forever)
# ADMIN_RATE_READ_MIN=120 / ADMIN_RATE_WRITE_10MIN=30 / ADMIN_RATE_EXPORT_HOUR=10   # per staff member

# ---- Home page ----
# LEADERBOARD_MIN_BETS=5       # settled LIVE bets a member needs in the last 30 days to appear on that board
# LEADERBOARD_MIN_BETS_DAY=3   # …and on the last-racing-day board

# ---- 5-star pick SMS alerts (members opt in on Home / My account) ----
# SMS_ALERTS=1                 # kill switch: default ON in development (mock sender), OFF in production unless set to 1
# SMS_PROVIDER=mock            # mock (logs "[sms:mock] +852****5678 …") | twilio. Production with SMS_ALERTS=1 requires twilio.
# Twilio Programmable Messaging (uses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above) and ONE of:
# TWILIO_MESSAGING_SERVICE_SID=  # preferred: sender pool, HK sender ID
# TWILIO_SMS_FROM=               # or a single sending number / alphanumeric sender ID
