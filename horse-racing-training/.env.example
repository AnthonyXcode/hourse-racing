# Copy to .env and edit. .env is gitignored.
#
#   cp .env.example .env
#
# Real environment variables win over this file, so pm2's env block (or an
# inline `PORT=9000 npm start`) overrides whatever is set here.

# Backend — the Express server: API, and in production the built SPA too.
# This is the port you open in production.
PORT=8787

# Frontend — the Vite dev server (`npm run dev` only).
# Not used in production: `npm run build` emits dist/, which the backend serves.
# Open this port during development.
WEB_PORT=5173

# Timezone. Keep Asia/Hong_Kong: on a UTC host, race dates come out a day early.
TZ=Asia/Hong_Kong

# Market momentum collector (Momentum tab). On race days the server snapshots
# HKJC WIN/PLA odds for every race inside the window before its post time.
MOMENTUM_POLLER=1          # 0 disables the background collector
MOMENTUM_INTERVAL_S=10     # seconds between snapshots
MOMENTUM_WINDOW_MIN=30     # start this many minutes before post time
# MOMENTUM_DB=data/momentum.sqlite   # SQLite file (default shown)

# Scheduled HKJC fetch of racecards + odds + results into the DB, every 5 min at
# 12:00–00:00 Hong Kong time (Playwright; needs `npx playwright install chromium`
# in the parent repo). Full card scrapes are hourly; see server/data/fetchJobs.ts. Off unless set to 1 — enable it on the machine that
# should keep the data current. Manual run: `npm run data:fetch [-- --dry-run]`.
DATA_FETCH=0

# Background refresh of Chinese horse/jockey/trainer/race names (1 page/s).
# On unless set to 0.
NAMES_REFRESH=1

# Google Analytics for Firebase runs in production builds only. Set to 1 to also send
# events from `npm run dev` (e.g. to check them in Firebase DebugView). Read by Vite at startup.
# VITE_ANALYTICS=1

# ---- Membership (HK mobile + SMS code login; docs/membership/PRD.md) ----
# The server refuses to start with NODE_ENV=production if OTP_PROVIDER=mock, the Turnstile test keys
# are in use, or any Twilio variable is missing.

# SMS codes: "mock" (dev default: the code is printed in the server log as
# "[otp:mock] +852****4567 code=123456") or "twilio" (production default).
OTP_PROVIDER=mock
# Twilio Verify credentials — set them only in the real .env / environment, never in git.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Cloudflare Turnstile (bot check before every SMS). Unset in dev = Cloudflare's always-pass test keys
# below. Production needs real keys from the Cloudflare dashboard.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# MEMBERS_DB=data/members.sqlite   # SQLite file for members, sessions and bet history (gitignored)
# AVATAR_DIR=data/avatars          # processed avatar images (gitignored)
# SESSION_TTL_DAYS=30              # login lasts this long since the last visit (sliding)

# Origin(s) allowed to make state-changing /api/auth, /api/me and /api/history calls (comma-separated).
# Production: the public https origin, e.g. https://posttime.example.
APP_ORIGIN=http://localhost:5173

# Behind nginx / Cloudflare: number of proxy hops to trust for the client IP (per-IP rate limits).
# TRUST_PROXY=1

# OTP send limits (optional overrides): per phone per hour / per day, per IP per hour.
# OTP_RATE_PHONE_HOUR=5
# OTP_RATE_PHONE_DAY=10
# OTP_RATE_IP_HOUR=20
