# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Comma-separated list of API keys (min 32 chars each). One key per consuming site
# lets you revoke/rotate one without breaking the others.
# Generate: openssl rand -hex 32
API_KEYS=replace-with-output-of-openssl-rand-hex-32

PORT=3000
NODE_ENV=development
