# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Comma-separated list of API keys (min 32 chars each). One key per consuming site
# lets you revoke/rotate one without breaking the others.
# Generate: openssl rand -hex 32
API_KEYS=replace-with-output-of-openssl-rand-hex-32

PORT=3000
NODE_ENV=development

# Race dates are Hong Kong calendar dates; keep this on servers in other time zones
TZ=Asia/Hong_Kong

# Race analysis cache (POST /v1/analyses) and max analyses running at once
ANALYSIS_CACHE_DIR=data/analysis
ANALYSIS_MAX_CONCURRENT=1

# Live scraping uses Playwright; the CLI skills run with PLAYWRIGHT_BROWSERS_PATH=0
# PLAYWRIGHT_BROWSERS_PATH=0
