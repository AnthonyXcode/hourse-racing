{
  "name": "hk-horse-racing",
  "version": "1.0.0",
  "description": "AI-assisted Hong Kong horse racing analysis and betting recommendation system",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dev:api": "tsx watch src/server/index.ts",
    "start:api": "node --import tsx src/server/index.ts",
    "scrape:racecard": "tsx src/scrapers/raceCard.ts",
    "scrape:historical": "tsx src/scrapers/historical.ts",
    "analyze": "tsx tools/analyze-race.ts",
    "odds": "tsx tools/fetch-odds.ts",
    "lint": "eslint src/**/*.ts",
    "test": "vitest",
    "optimize:HV": "npx tsx tools/backtest-differentiation.ts --sparse=3 --close=2 --avgdiff=15 --gap=1 --venue=HV --surface=Turf --form=all",
    "optimize:ST": "npx tsx tools/backtest-differentiation.ts --sparse=4 --close=4 --avgdiff=11 --gap=1 --venue=ST --surface=Turf --form=all --ignore-class=\"Griffin, 4 Year Olds\""
  },
  "keywords": [
    "horse-racing",
    "hkjc",
    "betting",
    "analysis",
    "monte-carlo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^8.56.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^3.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lodash": "^4.17.21",
    "playwright": "^1.41.0",
    "zod": "^3.22.0"
  }
}
